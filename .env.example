# !! WARNING !! This is an example file. Never use these values in production.
# Copy this file to `.env` and replace ALL sensitive values with your own.
# NEVER commit the `.env` file (check your .gitignore).
#
# ── How to use ───────────────────────────────────────────────────────────────
#  Dev  : `make dev` → app runs locally, DB/Redis via Docker (docker-compose.yml)
#  Prod : the app image is deployed by your cloud orchestrator.
#         DB_HOST / REDIS_HOST point to managed services (RDS, ElastiCache, etc.)
#         and are injected as environment variables by the orchestrator,
#         not from this file.

# ── App ──────────────────────────────────────────────────────────────────────
ENVIRONMENT=dev                          # test | dev | ppr | prod
APP_NAME=Nyaya
APP_VERSION=0.1.0
APP_DESCRIPTION=Nyaya backend API
APP_PORT=8000                            # internal port used by the uvicorn process
APP_WORKERS=1                            # uvicorn worker processes (≈ nb of vCPUs in prod)

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000"]   # list of allowed origins

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=DEBUG                          # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_MAX_BYTES=10485760                   # 10 MB
LOG_BACKUP_COUNT=5

# ── Database ─────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nyaya_db
DB_USER=nyaya_user
DB_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD
# !! openssl rand -hex 64

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD
# !! openssl rand -hex 64

# ── API Key ──────────────────────────────────────────────────────────────────
API_KEY=REPLACE_WITH_A_RANDOM_HEX_64_BYTES
# !! openssl rand -hex 64

# ── JWT ──────────────────────────────────────────────────────────────────────
JWT_ALGORITHM=HS256                      # HS256 | RS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30       # max 60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7          # max 45
JWT_SESSION_MAX_LIFETIME_DAYS=30         # max 100
JWT_SESSION_MAX_COUNT=5                  # max 10
JWT_SECRET_KEY=REPLACE_WITH_A_SECRET_KEY_OF_AT_LEAST_64_CHARS
# !! openssl rand -hex 64

# ── LLM ──────────────────────────────────────────────────────────────────────
LLM_TIMEOUT_SECONDS=60                   # max wait for an LLM response (10–300s)
LLM_BACKEND=ollama                       # ollama | mistral (overrides src/app/modules/llm/config.toml)
LLM_SYSTEM_PROMPT=Tu es un assistant utile et concis.
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=768
LLM_REASONING_EFFORT=none                # none|minimal|low|medium|high|xhigh (backend-dependent)

# ── Ollama LLM overrides ─────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:26b
OLLAMA_TIMEOUT_S=90

# ── Mistral LLM overrides ────────────────────────────────────────────────────
MISTRAL_API_KEY=
MISTRAL_API_KEY_ENV=MISTRAL_API_KEY
MISTRAL_BASE_URL=https://api.mistral.ai
MISTRAL_MODEL=mistral-medium-latest
MISTRAL_TIMEOUT_S=90

# ── Monthly review ───────────────────────────────────────────────────────────
REVIEW_MIN_MESSAGES=5                    # min messages in the month to trigger a review
REVIEW_TOP_WORST_CATEGORIES=3            # number of worst categories to analyse
REVIEW_WORST_MESSAGES_PER_CATEGORY=5     # number of worst messages to send to the LLM per category
