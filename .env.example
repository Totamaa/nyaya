# !! WARNING !! This is an example file. Never use these values in production.
# Copy this file to `.env` and replace ALL sensitive values with your own.
# NEVER commit the `.env` file (check your .gitignore).
#
# ── How to use ───────────────────────────────────────────────────────────────
#  Dev  : `make dev`  → app runs locally, DB/Redis via Docker (docker-compose.dev.yml)
#  Prod : `make prod` → everything in Docker     (docker-compose.prod.yml)
#          DB_HOST and REDIS_HOST are overridden in docker-compose.prod.yml
#          to point to the sibling containers — keep them as `localhost` here.

# ── App ──────────────────────────────────────────────────────────────────────
ENVIRONMENT=dev                          # test | dev | ppr | prod
APP_NAME=Nyaya
APP_VERSION=0.1.0
APP_DESCRIPTION=Nyaya backend API
APP_PORT=8000                            # internal port used by the uvicorn process
APP_WORKERS=1                            # uvicorn worker processes (≈ nb of vCPUs in prod)

# ── Docker image (prod) ──────────────────────────────────────────────────────
# Used as the image tag when building locally (make build/prod)
# and as the image source when pulling from a registry (make prod-update).
# Format: <registry>/<org>/<repo>:<tag>
# Examples:
#   ghcr.io/your-org/nyaya-app:latest    (GitHub Container Registry)
#   your-dockerhub-user/nyaya-app:latest (Docker Hub)
DOCKER_IMAGE=nyaya-app:latest

# ── Caddy (prod reverse proxy) ────────────────────────────────────────────────
APP_DOMAIN=api.example.com               # domain pointing to your server (for TLS cert)
CADDY_EMAIL=you@example.com             # email for Let's Encrypt expiry notifications
# Let's Encrypt endpoint — start with staging to avoid burning your quota (5 certs/week):
#   Staging (no rate limit, cert not trusted by browsers):
#     https://acme-staging-v02.api.letsencrypt.org/directory
#   Production (real trusted cert):
#     https://acme-v02.api.letsencrypt.org/directory
CADDY_ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000"]   # list of allowed origins

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=DEBUG                          # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_MAX_BYTES=10485760                   # 10 MB
LOG_BACKUP_COUNT=5

# ── Database ─────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nyaya_db
DB_USER=nyaya_user
DB_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD   # !! min 8 chars, max 128

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD   # !! used by both Docker and the app

# ── JWT ──────────────────────────────────────────────────────────────────────
# !! Generate a secure key with: openssl rand -hex 32
JWT_SECRET_KEY=REPLACE_WITH_A_SECRET_KEY_OF_AT_LEAST_64_CHARS
JWT_ALGORITHM=HS256                      # HS256 | RS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30       # max 60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7          # max 45
JWT_SESSION_MAX_LIFETIME_DAYS=30         # max 100
JWT_SESSION_MAX_COUNT=5                  # max 10

# ── LLM ──────────────────────────────────────────────────────────────────────
LLM_TIMEOUT_SECONDS=60                   # max wait for an LLM response (10–300s)
